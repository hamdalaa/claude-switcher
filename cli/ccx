#!/usr/bin/env bash
# ccx — run Claude Code on one of two subscription accounts, with shared (synced) config.
# Part of Claude Switcher (MIT). https://github.com/hamdalaa/claude-switcher
# ccx-managed-by: claude-switcher
#
#   ccx              start on the switched-to account (pinned, else whichever has more headroom)
#   ccx a|b [...]    start on a specific account (extra args go to claude)
#   ccx run [...]    like plain ccx, but passes ALL args to claude (used by the `claude` shell hook)
#   ccx use a|b|auto pin the account new sessions start on (auto = most headroom)
#   ccx which        print the account the next session would use
#   ccx login a|b    sign in an account (opens the browser)
#   ccx logout a|b   sign out an account
#   ccx status       who is signed in where + last-known usage
#   ccx sync         re-link shared config into account B (runs on every B launch)
#   ccx version      print the version
#
# Account A is Claude Code's normal config (~/.claude); account B lives in ~/.claude-b and
# shares A's settings, skills, agents, commands, memory and history through symlinks.
#
# Safety: each account keeps its own OAuth token in its own Keychain item — Claude Code
# namespaces the item by a hash of CLAUDE_CONFIG_DIR. This script never reads, copies or
# moves tokens; switching just picks which config dir claude starts with.
set -euo pipefail

CCX_VERSION="1.1.0"

A_DIR="$HOME/.claude"
B_DIR="$HOME/.claude-b"
STATE_ROOT="$HOME/.claude-accounts"
STATE_DIR="$STATE_ROOT/usage"
PIN_FILE="$STATE_ROOT/default"
LIMIT_PCT=90

# Everything account-independent is shared with account A via symlinks.
SHARED=(CLAUDE.md AGENTS.md rules skills agents commands hooks scripts plugins output-styles
        settings.json settings.local.json keybindings.json themes projects history.jsonl
        file-history plans todos)

# Directories created in A if missing, so B shares them from the first launch.
SHARED_DIRS=(projects file-history todos plans)

# Top-level ~/.claude.json keys copied A → B on launch. Never the login (oauthAccount etc.).
SYNC_KEYS='["mcpServers","theme","hasCompletedOnboarding","lastOnboardingVersion","editorMode","autoUpdates"]'

die() { echo "ccx: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$2"; }
upper() { tr '[:lower:]' '[:upper:]' <<<"$1"; }
dir_of() { [ "$1" = b ] && echo "$B_DIR" || echo "$A_DIR"; }
json_of() { [ "$1" = b ] && echo "$B_DIR/.claude.json" || echo "$HOME/.claude.json"; }
check_acct() { [[ "${1:-}" =~ ^[ab]$ ]] || die "account must be 'a' or 'b'"; }

with_env() {  # run a command under account $1's config dir
  local acct=$1; shift
  if [ "$acct" = b ]; then CLAUDE_CONFIG_DIR="$B_DIR" "$@"; else env -u CLAUDE_CONFIG_DIR "$@"; fi
}

email_of() {  # signed-in email from the account's config, empty if none
  local f; f=$(json_of "$1")
  [ -f "$f" ] && jq -r '.oauthAccount.emailAddress // empty' "$f" 2>/dev/null || true
}

logged_in() {
  with_env "$1" claude auth status 2>/dev/null | jq -e '.loggedIn == true' >/dev/null 2>&1
}

usage_of() {  # prints "<5h> <7d>" integers; expired window = 0, unknown = 0
  local file="$STATE_DIR/$1.json"
  [ -f "$file" ] || { echo "0 0"; return; }
  jq -r --argjson now "$(date +%s)" '
    def pct(w): if w == null or (w.resets_at // 0) < $now then 0 else (w.used_percentage // 0 | floor) end;
    "\(pct(.five_hour)) \(pct(.seven_day))"' "$file"
}

resets_of() {  # human-readable reset time of the 5h window, if known and in the future
  local file="$STATE_DIR/$1.json" ts
  [ -f "$file" ] || return 0
  ts=$(jq -r '.five_hour.resets_at // empty | floor' "$file" 2>/dev/null || true)
  [ -n "$ts" ] && [ "$ts" -gt "$(date +%s)" ] && date -r "$ts" '+%H:%M'
  return 0
}

pick() {
  local pin; pin=$(cat "$PIN_FILE" 2>/dev/null || true)
  [[ "$pin" =~ ^[ab]$ ]] && { echo "$pin"; return; }
  # An account that was never signed in can't be picked.
  [ -z "$(email_of b)" ] && { echo a; return; }
  local a5 a7 b5 b7
  read -r a5 a7 <<<"$(usage_of a)"
  read -r b5 b7 <<<"$(usage_of b)"
  local a_full=$(( a5 >= LIMIT_PCT || a7 >= LIMIT_PCT ))
  local b_full=$(( b5 >= LIMIT_PCT || b7 >= LIMIT_PCT ))
  if   (( a_full && !b_full )); then echo b
  elif (( b_full && !a_full )); then echo a
  elif (( a5 != b5 )); then (( a5 < b5 )) && echo a || echo b
  else (( a7 <= b7 )) && echo a || echo b
  fi
}

sync_links() {
  mkdir -p "$B_DIR" "$STATE_DIR"
  chmod 700 "$B_DIR"
  local dir item
  for dir in "${SHARED_DIRS[@]}"; do mkdir -p "$A_DIR/$dir"; done
  for item in "${SHARED[@]}"; do
    [ -e "$A_DIR/$item" ] || continue
    [ -L "$B_DIR/$item" ] && continue
    if [ -e "$B_DIR/$item" ]; then echo "ccx: skip $item (real file in $B_DIR, not linking over it)" >&2; continue; fi
    ln -s "$A_DIR/$item" "$B_DIR/$item"
  done
}

sync_json() {  # merge shared ~/.claude.json keys into B's, keeping B's login untouched
  local src="$HOME/.claude.json" dst="$B_DIR/.claude.json" tmp
  [ -f "$src" ] || return 0
  tmp=$(mktemp "$B_DIR/.claude.json.XXXXXX") || return 1
  if [ ! -f "$dst" ]; then
    echo '{}' > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$dst" || { rm -f "$tmp"; return 1; }
    tmp=$(mktemp "$B_DIR/.claude.json.XXXXXX") || return 1
  fi
  if jq --argjson keys "$SYNC_KEYS" --slurpfile a "$src" '
       . as $b | reduce $keys[] as $k ($b; if ($a[0] | has($k)) then .[$k] = $a[0][$k] else . end)
     ' "$dst" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    # Unchanged → don't rewrite, so a running B session's own writes are never raced.
    if cmp -s "$tmp" "$dst"; then rm -f "$tmp"; return 0; fi
    chmod 600 "$tmp" && mv "$tmp" "$dst"
  else
    rm -f "$tmp"; echo "ccx: couldn't sync settings into B's .claude.json (left unchanged)" >&2
    return 1
  fi
}

sync_all() { sync_links; sync_json; }

# Signed in some other way (API key, Bedrock, Vertex)? Then there's no Claude login to check.
uses_other_auth() {
  [ -n "${ANTHROPIC_API_KEY:-}${ANTHROPIC_AUTH_TOKEN:-}${CLAUDE_CODE_USE_BEDROCK:-}${CLAUDE_CODE_USE_VERTEX:-}" ]
}

# run_on <acct> <prompt-login: yes|no> [claude args...]
run_on() {
  local acct=$1 prompt=$2; shift 2
  need claude "Claude Code isn't installed or isn't on PATH — see https://docs.claude.com/claude-code"
  # Inherited from a parent Claude session these make claude think it's a child (no transcripts).
  unset CLAUDECODE CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_SESSION_ID CLAUDE_CODE_SESSION_ATTENDED \
        CLAUDE_PID CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_EXECPATH
  if [ "$acct" = b ]; then sync_all || true; fi
  # Only explicit `ccx a|b` offers to sign in; `ccx run` (the `claude` hook) stays transparent,
  # so `claude --version`, `claude -p …` and scripts never get a login prompt.
  if [ "$prompt" = yes ] && ! uses_other_auth && [ -z "$(email_of "$acct")" ] && ! logged_in "$acct"; then
    echo "ccx: account $(upper "$acct") isn't signed in yet — signing in first." >&2
    with_env "$acct" claude auth login
  fi
  if [ "$acct" = b ]; then CLAUDE_CONFIG_DIR="$B_DIR" exec claude "$@"
  else exec env -u CLAUDE_CONFIG_DIR claude "$@"; fi
}

show_status() {
  local acct five seven reset email pin
  for acct in a b; do
    email=$(email_of "$acct")
    read -r five seven <<<"$(usage_of "$acct")"
    reset=$(resets_of "$acct")
    printf '%s  %-28s' "$(upper "$acct")" "${email:-(not signed in — ccx login $acct)}"
    if [ -f "$STATE_DIR/$acct.json" ]; then
      printf '  5h %3s%%  7d %3s%%%s' "$five" "$seven" "${reset:+  (5h resets $reset)}"
    else
      printf '  no usage data yet'
    fi
    printf '\n'
  done
  pin=$(cat "$PIN_FILE" 2>/dev/null || true)
  [ -n "$pin" ] && pin="pinned to $(upper "$pin")" || pin="auto (most headroom)"
  printf 'mode: %s   next ccx → %s\n' "$pin" "$(upper "$(pick)")"
}

case "${1:-}" in
  version|--version|-v) echo "ccx $CCX_VERSION"; exit 0 ;;
  -h|--help|help) sed -n '5,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

need jq "jq is required (built into macOS 15+, or: brew install jq)"

case "${1:-}" in
  a|b)      acct=$1; shift; run_on "$acct" yes "$@" ;;
  use)      case "${2:-}" in
              a|b)  mkdir -p "$STATE_ROOT"; echo "$2" > "$PIN_FILE"; echo "ccx now starts on account $(upper "$2")" ;;
              auto) rm -f "$PIN_FILE"; echo "ccx now picks the account with more headroom" ;;
              *)    die "usage: ccx use a|b|auto" ;;
            esac ;;
  login)    check_acct "${2:-}"; need claude "Claude Code isn't installed or isn't on PATH"; if [ "$2" = b ]; then sync_all || true; fi; with_env "$2" claude auth login; show_status ;;
  logout)   check_acct "${2:-}"; need claude "Claude Code isn't installed or isn't on PATH"; with_env "$2" claude auth logout ;;
  run)      shift; run_on "$(pick)" no "$@" ;;
  which)    pick ;;
  status|usage) show_status ;;
  sync|setup)   if sync_all; then echo "account B synced at $B_DIR"; else exit 1; fi ;;
  *)        acct=$(pick); echo "ccx → account $(upper "$acct")" >&2; run_on "$acct" yes "$@" ;;
esac
